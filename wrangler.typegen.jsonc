{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cali-central-typegen",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
