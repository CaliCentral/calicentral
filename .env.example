# Public Sanity connection values. Leave the project ID empty to use the
# repository's fictional local fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Optional reviewed HTTPS URL for the separately hosted Sanity Studio.
NEXT_PUBLIC_SANITY_STUDIO_URL=

# Server-only Viewer token used for published reads from the required private
# production dataset and for protected Draft Mode. Never expose it with a
# NEXT_PUBLIC_ prefix.
SANITY_API_READ_TOKEN=

# Server-only least-privilege token used by guarded contributor/editorial
# mutations and the manually invoked seed command. It is never sent to clients.
SANITY_API_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-read launch controls. Production indexing requires both
# SITE_STAGE=production and SITE_INDEXING_ENABLED=true. Development, preview,
# and prototype modes remain noindex by default.
SITE_STAGE=development
SITE_INDEXING_ENABLED=false

# Optional owner-reviewed address rendered on policy pages. Leave empty rather
# than inventing a public contact.
SITE_CONTACT_EMAIL=

# Auth.js encrypts JWT sessions with this server-only secret. Generate a
# cryptographically random value for local and deployed environments.
AUTH_SECRET=

# Canonical Auth.js origin. Keep this aligned with NEXT_PUBLIC_SITE_URL. It
# prevents OAuth callbacks from relying on an untrusted Host header.
AUTH_URL=http://localhost:3000

# OAuth providers are enabled only when both values in a pair are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated, case-insensitive bootstrap access lists. Do not place real
# account addresses in this committed example file.
CALI_CENTRAL_ADMIN_EMAILS=
CALI_CENTRAL_EDITOR_EMAILS=

# Server-read feature gates. Every unfinished or persistence-backed feature
# fails closed unless its value is exactly true. Community additionally needs
# a reviewed COMMUNITY_DB D1 binding; the flag never creates persistence.
COMMUNITY_FEATURES_ENABLED=false
COMMUNITY_MEDIA_UPLOADS_ENABLED=false
TEAM_APPLICATIONS_ENABLED=false
ORGANIZATION_CLAIMS_ENABLED=false
VIDEO_SUBMISSIONS_ENABLED=false
MEDIA_SUBMISSIONS_ENABLED=false
SHOP_FEATURES_ENABLED=false
PRODUCT_SUBMISSIONS_ENABLED=false
PUBLIC_PROSPECTIVE_TEAMS_ENABLED=false
WCL_FEATURES_ENABLED=false
EXTERNAL_RANKINGS_ENABLED=false

# Explicit WCL calculation version. 2.0 remains the default official metadata
# record. Use 3.0-proposed only for clearly labeled proposal testing.
WCL_ACTIVE_RULESET=2.0

# Supabase migration target. AUTH_MIGRATION_PROVIDER defaults to authjs and
# must remain there until the Supabase session/provisioning equivalence gate
# passes. The service role key is server-only and is never browser-exposed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_MIGRATION_PROVIDER=authjs

# Standard S3-compatible R2 access for the Vercel runtime. Keep the bucket
# private; application delivery remains authorization-gated.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cali-central-community-media-preview

# Optional Vercel production rate-limit provider. If configured but
# unavailable, protected writes fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
